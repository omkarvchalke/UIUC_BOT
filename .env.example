# Root env file consumed by docker-compose.yml.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Postgres ---
POSTGRES_USER=illiniguide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=illiniguide
POSTGRES_PORT=5433

# --- Backend ---
BACKEND_PORT=8000
GROQ_API_KEY=

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Production only (docker-compose.prod.yml) ---
# Required when running with the prod overlay; unused otherwise. See the
# Deployment section in README.md.
FRONTEND_PUBLIC_URL=
BACKEND_PUBLIC_URL=
