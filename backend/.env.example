# Backend runtime config. Copy to `backend/.env` for local (non-docker) dev.
# Inside docker-compose, these are injected as environment variables instead.

APP_NAME=IlliniAssist AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- LLM (Groq) ---
GROQ_API_KEY=
# llama-3.3-70b-versatile: the previous default, meta-llama/llama-4-scout-
# 17b-16e-instruct, was pulled from Groq's model catalog (confirmed 2026-07-
# 27 via a real GET /openai/v1/models call -- it 404s as "does not exist or
# you do not have access to it" on chat completions). llama-3.3-70b-versatile
# was already this project's documented runner-up (see
# docs/production-readiness.md history / README Groq Integration section)
# and, re-verified against this account today, still returns clean JSON-mode
# output on the first try at a 12,000 TPM limit. The other currently-listed
# candidates (openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b) are
# reasoning models that burned the completion-token budget on internal
# reasoning before emitting the JSON envelope, tripping Groq's server-side
# json_validate_failed error at the same max_completion_tokens budget this
# model handled cleanly -- also a lower 8,000 TPM. Re-check
# GET /openai/v1/models on this account if this ever needs revisiting; Groq
# has changed its free-tier lineup before and will again.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Local embeddings (no paid API) ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- PostgreSQL (also stores vector embeddings via pgvector -- no separate
# vector store/service; the local docker-compose Postgres image is
# pgvector/pgvector, which bundles the extension) ---
DATABASE_URL=postgresql+asyncpg://illiniguide:change-me@localhost:5432/illiniguide

# --- Pipeline tuning (optional -- these are the defaults; uncomment to override) ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVAL_CANDIDATE_LIMIT=20
# RERANK_TOP_K=8
# TOPIC_FILTER_MIN_RESULTS=3
# TOPIC_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.55
# GROQ_TEMPERATURE=0.2
# GROQ_MAX_COMPLETION_TOKENS=4096
# CRAWL_DEFAULT_MAX_DEPTH=4
# CRAWL_DEFAULT_MAX_PAGES=60
